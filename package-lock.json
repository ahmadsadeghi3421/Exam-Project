import React, { useState } from "react"; import { BrowserRouter as Router, Routes, Route, useNavigate, useParams } from "react-router-dom";

const initialInvoices = [ { id: "12345", buyer: "Rick Sanchez", phone: "09120000000", seller: "Citadel Shop", date: "2025/01/10", items: [ { name: "Portal Gun", price: 500, qty: 1 }, { name: "Plumbus", price: 100, qty: 2 } ] }, { id: "987654", buyer: "Morty Smith", phone: "09350000000", seller: "Earth Store", date: "2025/02/02", items: [{ name: "Mega Seed", price: 300, qty: 3 }] } ];

function App() { const [invoices, setInvoices] = useState(initialInvoices); return ( <Router> <div style={styles.app}> <h1 style={styles.title}>🧪 Invoice Manager</h1> <Routes> <Route path="/" element={<InvoiceList invoices={invoices} />} /> <Route path="/invoice/:id" element={<InvoiceDetails invoices={invoices} setInvoices={setInvoices} />} /> </Routes> </div> </Router> ); }

function InvoiceList({ invoices }) { const [search, setSearch] = useState(""); const [selected, setSelected] = useState(null); const navigate = useNavigate();

const filtered = invoices.filter(i => i.id.includes(search));

return ( <div> <div style={styles.searchBar}> <input style={styles.input} placeholder="شماره فاکتور 5 یا 6 رقمی" value={search} onChange={e => setSearch(e.target.value)} /> <button style={styles.btn}>➕ افزودن فاکتور</button> </div>

<ul style={styles.list}>
    {filtered.map(inv => (
      <li key={inv.id} style={styles.listItem}>
        <input type="radio" name="invoice" onChange={() => setSelected(inv.id)} />
        <span style={{ marginLeft: 8 }}>فاکتور #{inv.id}</span>
      </li>
    ))}
  </ul>

  <button
    style={styles.btn}
    disabled={!selected}
    onClick={() => navigate(/invoice/${selected})}
  >
    مشاهده جزئیات فاکتور
  </button>
</div>

); }

function InvoiceDetails({ invoices, setInvoices }) { const { id } = useParams(); const invoice = invoices.find(i => i.id === id); const [showEdit, setShowEdit] = useState(false);

if (!invoice) return <p>فاکتور پیدا نشد</p>;

const total = invoice.items.reduce((s, i) => s + i.price * i.qty, 0); const taxTotal = total * 1.12;

return ( <div> <h2>فاکتور #{invoice.id}</h2>

<ul style={styles.infoList}>
    <li>خریدار: {invoice.buyer}</li>
    <li>تلفن: {invoice.phone}</li>
    <li>فروشنده: {invoice.seller}</li>
    <li>تاریخ: {invoice.date}</li>
  </ul>

  <h3>کالاها</h3>
  <ul style={styles.list}>
    {invoice.items.map((it, idx) => (
      <li key={idx} style={styles.listItem}>
        {it.name} | فی: {it.price} | تعداد: {it.qty} | مجموع: {it.price * it.qty}
      </li>
    ))}
  </ul>

  <p>جمع کل: {total}</p>
  <p>جمع با مالیات 12٪: {taxTotal}</p>

  <button style={styles.btn} onClick={() => setShowEdit(true)}>ویرایش فاکتور</button>

  {showEdit && (
    <EditPopup invoice={invoice} invoices={invoices} setInvoices={setInvoices} onClose={() => setShowEdit(false)} />
  )}
</div>

); }

function EditPopup({ invoice, invoices, setInvoices, onClose }) { const [items, setItems] = useState(invoice.items);

const updateItem = (i, field, value) => { const newItems = [...items]; newItems[i][field] = value; setItems(newItems); };

const save = () => { setInvoices(invoices.map(inv => inv.id === invoice.id ? { ...inv, items } : inv)); onClose(); };

return ( <div style={styles.popup}> <div style={styles.popupContent}> <h3>ویرایش کالاها</h3> {items.map((it, i) => ( <div key={i} style={styles.row}> <input value={it.name} onChange={e => updateItem(i, "name", e.target.value)} /> <input type="number" value={it.price} onChange={e => updateItem(i, "price", +e.target.value)} /> <input type="number" value={it.qty} onChange={e => updateItem(i, "qty", +e.target.value)} /> <span>{it.price * it.qty}</span> </div> ))} <button style={styles.btn} onClick={save}>ثبت</button> <button style={styles.btn} onClick={onClose}>بستن</button> </div> </div> ); }
const styles = { app: { background: "#0b1e2d", minHeight: "100vh", color: "#00ff9c", padding: 20, fontFamily: "monospace" }, title: { textAlign: "center" }, searchBar: { display: "flex", gap: 10, marginBottom: 20 }, input: { padding: 8, flex: 1 }, btn: { padding: "8px 16px", background: "#00ff9c", border: "none", cursor: "pointer" }, list: { listStyle: "none", padding: 0 }, listItem: { background: "#102f44", marginBottom: 6, padding: 8 }, infoList: { listStyle: "none", padding: 0 }, popup: { position: "fixed", inset: 0, background: "rgba(0,0,0,0.7)", display: "flex", justifyContent: "center", alignItems: "center" }, popupContent: { background: "#102f44", padding: 20, width: 400 }, row: { display: "flex", gap: 6, marginBottom: 6 } };

export default App;